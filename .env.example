# Copy the values you need into .env.local (git-ignored). Never commit real values.
# Locally, `neon env pull` writes the Neon variables into .env.local for you.

# ── Neon Postgres (backend) ──────────────────────────────────────────
DATABASE_URL=            # pooled (-pooler host): app runtime traffic
DATABASE_URL_UNPOOLED=   # direct: Prisma migrations only

# ── Backend ──────────────────────────────────────────────────────────
JWT_SECRET=              # long random string
AI_SERVICE_URL=          # e.g. https://<user>-clausetrace-ai.hf.space
AI_SERVICE_TOKEN=        # shared secret, same value set on the HF Space
CORS_ORIGIN=             # comma-separated, e.g. https://clausetrace.vercel.app
PORT=4000

# ── AI service (Hugging Face Space secrets) ─────────────────────────
GEMINI_API_KEY=
# AI_SERVICE_TOKEN=      (same value as above)

# ── Frontend (Vercel env) ───────────────────────────────────────────
VITE_API_URL=            # Render backend URL; leave empty in local dev

# ── Seed (.env.seed.local) ──────────────────────────────────────────
SEED_ADMIN_PASSWORD=     # at least 12 characters
SEED_REVIEWER_PASSWORD=
SEED_VIEWER_PASSWORD=
