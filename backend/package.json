{
  "name": "clausetrace-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:local": "dotenv -e ../.env.local -- node dist/server.js",
    "dev": "dotenv -e ../.env.local -- tsx watch src/server.ts",
    "db:migrate": "dotenv -e ../.env.local -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "dotenv -e ../.env.local -e ../.env.seed.local -- tsx prisma/seed.ts",
    "db:verify": "dotenv -e ../.env.local -- tsx prisma/verify-chain.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
